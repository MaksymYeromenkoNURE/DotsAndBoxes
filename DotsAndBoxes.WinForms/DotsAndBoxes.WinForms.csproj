<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotsAndBoxes.Application\DotsAndBoxes.Application.csproj" />
		<ProjectReference Include="..\DotsAndBoxes.Core\DotsAndBoxes.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\Resources\Audio\*.mp3">
			<Link>Resources\Audio\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="3.3.0" />
	</ItemGroup>
</Project>